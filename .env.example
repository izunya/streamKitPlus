# 플랫폼 키 — 이 파일을 .env 로 복사해서 값을 채우세요.
#
# 빌드할 때 이 값들이 앱 안에 들어갑니다. 비워둔 채로 빌드하면 사용자가
# 로그인을 할 수 없습니다. 배포용 빌드 전에 값이 들어갔는지 확인하세요.
#
# .env 는 저장소에 올라가지 않습니다. 커밋하지 마세요.

# 유튜브 — https://console.cloud.google.com/apis/credentials
# secret 은 없어도 됩니다 (PKCE 를 씁니다).
SKP_YOUTUBE_CLIENT_ID=
SKP_YOUTUBE_CLIENT_SECRET=

# 트위치 — https://dev.twitch.tv/console/apps
# secret 은 없어도 됩니다 (Device Code Flow 를 씁니다).
SKP_TWITCH_CLIENT_ID=
SKP_TWITCH_CLIENT_SECRET=

# 치지직 — https://developers.chzzk.naver.com/application
# secret 이 반드시 필요합니다.
SKP_CHZZK_CLIENT_ID=
SKP_CHZZK_CLIENT_SECRET=

# CIME — https://developers.ci.me/applications
# secret 이 반드시 필요합니다.
SKP_CIME_CLIENT_ID=
SKP_CIME_CLIENT_SECRET=
